APP_ENV=local
APP_URL=http://localhost:3000
DATABASE_URL=postgres://travel:travel@127.0.0.1:55432/travel_dev
DATABASE_TEST_URL=postgres://travel:travel@127.0.0.1:55432/travel_test
# Every price on the site comes from Duffel; there is no fallback data, so the
# app refuses to boot without a token. Put the real one in .env.local.
FLIGHT_SEARCH_PROVIDER=duffel
DUFFEL_ACCESS_TOKEN=
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_SUPPLIER_TIMEOUT_MS=20000
# These defaults point at Mailpit, the local mail catcher on port 8025: mail is
# captured, never delivered. Real delivery goes through Resend over plain SMTP:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend          <- the literal word, not an address
#   SMTP_PASSWORD=re_…        <- a Resend API key, .env.local only (gitignored)
# SMTP_FROM must be a mailbox at a domain verified in the Resend account. It can
# never be the gmail.com address: Resend will not send as a domain it does not
# hold, and Gmail's own DMARC policy tells receivers to reject anyone who tries.
# The Gmail address rides as Reply-To and Cc instead, so the customer's replies
# still land in the agency's inbox.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NEWTEC TRAVEL AND TOURS <newtectravelagency@gmail.com>
# Copied on the welcome email the customer receives, so the agency holds its own
# side of that thread.
INQUIRY_NOTIFICATION_EMAIL=newtectravelagency@gmail.com
# Whether a new request also sends that welcome email. Off until a real relay is
# configured: /admin is the record either way, and the outbox row is written
# whether this is on or off, so turning it on later loses nothing.
INQUIRY_EMAIL_ENABLED=false
# The one credential guarding /admin, which lists customer contact details.
# There is no username. Production refuses to boot on this default, or on
# anything shorter than 16 characters.
ADMIN_PASSWORD=local-admin-password
