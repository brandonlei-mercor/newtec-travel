          "name": "flight_offer_caches_cabin_concrete",
          "value": "\"flight_offer_caches\".\"cabin\" <> 'NO_PREFERENCE'"
        },
        "flight_offer_caches_expiry_ordered": {
          "name": "flight_offer_caches_expiry_ordered",
          "value": "\"flight_offer_caches\".\"expires_at\" > \"flight_offer_caches\".\"fetched_at\""
        }
